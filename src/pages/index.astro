---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHero from '../components/SiteHero.astro';
import SideRail from '../components/SideRail.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, countBy, formatDate, postHref } from '../utils/site';

const posts = await getPosts();
const categories = countBy(posts.map((p) => p.data.category));
const tags = countBy(posts.flatMap((p) => p.data.tags));

const [featured, ...rest] = posts;
---

<BaseLayout>
  <SiteHero />

  <div class="work" id="content">
    <SideRail postCount={posts.length} categories={categories} tags={tags} />

    <main>
      {featured ? (
        <a class="feat glass glass-hover" href={postHref(featured)}>
          {featured.data.cover
            ? <img class="fcover" src={featured.data.cover} alt="" loading="eager" />
            : <div class="fcover ph"></div>}
          <div class="veil"></div>
          <div class="fbody">
            <span class="pin">
              <span class="ic-tag" aria-hidden="true"></span>置顶
            </span>
            <h2>{featured.data.title}</h2>
            {featured.data.description && <p>{featured.data.description}</p>}
            <div class="fmeta">
              {featured.data.category} · {formatDate(featured.data.pubDate)}
            </div>
          </div>
        </a>
      ) : (
        <div class="empty glass">
          还没有文章。往 <code>src/content/blog/</code> 里放 Markdown 就会出现在这里。
        </div>
      )}

      {rest.length > 0 && (
        <div class="sec-head">
          <h2>最近更新</h2>
          <span class="rule dash"></span>
          <a class="more" href="/blog/">全部文章 →</a>
        </div>
      )}

      <div class="posts">
        {rest.slice(0, 5).map((post) => <PostCard post={post} />)}
      </div>

      <div class="status">
        <span>导航收藏夹和在线工具还在做，预计这周能上。</span>
        <span class="r">{formatDate(new Date())}</span>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .work {
    max-width: 1180px;
    margin: 0 auto;
    padding: 38px var(--shell-pad) 60px;
    display: grid;
    grid-template-columns: 258px 1fr;
    gap: 24px;
    align-items: start;
    /* 点 Hero 的下滑箭头跳到这里时，别被吸顶导航挡住 */
    scroll-margin-top: calc(var(--navbar-h) + 16px);
  }

  main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* 精选大卡 */
  .feat {
    position: relative;
    display: block;
    min-height: 232px;
    overflow: hidden;
    text-decoration: none;
  }
  .fcover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg,
      color-mix(in srgb, var(--bg) 96%, transparent) 0%,
      color-mix(in srgb, var(--bg) 86%, transparent) 46%,
      color-mix(in srgb, var(--bg) 20%, transparent) 100%);
  }
  .fbody {
    position: relative;
    z-index: 2;
    padding: 28px 32px;
    max-width: 68%;
  }
  .pin {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: color-mix(in srgb, var(--pin) 40%, var(--text-deep));
    background: var(--pin-border);
    border: 1px solid var(--pin);
    border-radius: 6px;
    padding: 2px 9px;
    margin-bottom: 13px;
  }
  .fbody h2 {
    font-size: 24px;
    font-weight: 400;
    color: var(--text-deep);
    line-height: 1.45;
    margin-bottom: 11px;
  }
  .feat:hover .fbody h2 { color: var(--primary-dark); }
  .fbody p { font-size: 13px; color: var(--text-muted); line-height: 1.75; }
  .fmeta {
    margin-top: 14px;
    font-size: 12px;
    color: var(--c-date);
    font-family: var(--mono);
  }

  .posts { display: flex; flex-direction: column; gap: 14px; }

  .empty {
    padding: 50px 30px;
    text-align: center;
    color: var(--text-muted);
    font-size: 14px;
  }
  .empty code {
    font-family: var(--mono);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    padding: 2px 7px;
    border-radius: 5px;
    color: var(--primary-dark);
  }

  @media (max-width: 1080px) {
    .work { grid-template-columns: 1fr; padding-top: 26px; }
    .fbody { max-width: 100%; }
    .veil {
      background: linear-gradient(180deg,
        color-mix(in srgb, var(--bg) 96%, transparent) 0%,
        color-mix(in srgb, var(--bg) 88%, transparent) 60%,
        color-mix(in srgb, var(--bg) 30%, transparent) 100%);
    }
  }
</style>
