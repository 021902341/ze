---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getPosts,
  formatDate,
  readingTime,
  categoryHref,
  tagHref,
  postHref,
  type Post,
} from '../../utils/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: i > 0 ? posts[i - 1] : null,
      older: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }));
}

interface Props {
  post: Post;
  newer: Post | null;
  older: Post | null;
}

const { post, newer, older } = Astro.props;
const { data, body } = post as Post & { body?: string };
const { Content, headings } = await render(post);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={`${data.title} · ze`} description={data.description ?? data.title}>
  <main class="wrap">
    <nav class="crumb">
      <a href="/blog/">文章</a>
      <span aria-hidden="true">/</span>
      <a href={categoryHref(data.category)}>{data.category}</a>
    </nav>

    <article data-pagefind-body>
      <header class="head">
        <div class="tax">
          <a class="folder" href={categoryHref(data.category)}>
            <span class="ic-folder" aria-hidden="true"></span>{data.category}
          </a>
          <span class="sep" aria-hidden="true">·</span>
          <span class="dt">
            <span class="ic-clock" aria-hidden="true"></span>
            <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
          </span>
          <span class="sep" aria-hidden="true">·</span>
          <span class="dt">{readingTime(body)} 分钟</span>
          {data.updatedDate && (
            <>
              <span class="sep" aria-hidden="true">·</span>
              <span class="dt">更新于 {formatDate(data.updatedDate)}</span>
            </>
          )}
        </div>

        <h1>{data.title}</h1>
        {data.description && <p class="lead">{data.description}</p>}
      </header>

      {data.cover && <img class="cover" src={data.cover} alt="" loading="eager" />}

      {toc.length >= 3 && (
        <nav class="toc glass" aria-label="目录">
          <div class="toc-t rhombo-h">目录</div>
          <ol>
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'lvl3' : ''}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose">
        <Content />
      </div>

      {data.tags.length > 0 && (
        <footer class="tags">
          <span class="lab">标签</span>
          {data.tags.map((t) => (
            <a class="chip" href={tagHref(t)}>
              <span class="ic-tag" aria-hidden="true"></span>{t}
            </a>
          ))}
        </footer>
      )}

      {(newer || older) && (
        <nav class="adj">
          {older ? (
            <a class="glass glass-hover" href={postHref(older)}>
              <span class="dir">上一篇</span>
              <span class="ttl">{older.data.title}</span>
            </a>
          ) : <span />}
          {newer ? (
            <a class="glass glass-hover right" href={postHref(newer)}>
              <span class="dir">下一篇</span>
              <span class="ttl">{newer.data.title}</span>
            </a>
          ) : <span />}
        </nav>
      )}
    </article>

    <p class="back"><a href="/blog/">← 返回文章列表</a></p>
  </main>
</BaseLayout>

<style>
  .wrap {
    max-width: 780px;
    margin: 0 auto;
    padding: 30px var(--shell-pad) 60px;
  }

  .crumb {
    display: flex;
    gap: 8px;
    font-size: 12.5px;
    color: var(--text-muted);
    margin-bottom: 22px;
  }
  .crumb a { color: var(--text-muted); text-decoration: none; }
  .crumb a:hover { color: var(--primary-dark); }

  .head { padding-bottom: 24px; border-bottom: 2px dashed color-mix(in srgb, var(--primary) 34%, var(--divider)); margin-bottom: 26px; }

  .tax {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 12.5px;
    margin-bottom: 15px;
  }
  .folder {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--c-folder);
    text-decoration: none;
  }
  .dt {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--c-date);
    font-family: var(--mono);
  }
  .sep { color: var(--text-muted); opacity: .6; }

  h1 {
    font-size: clamp(26px, 4.4vw, 38px);
    font-weight: 400;
    color: var(--text-deep);
    line-height: 1.4;
    letter-spacing: .01em;
    margin-bottom: 14px;
  }

  .lead { font-size: 15px; color: var(--text-muted); line-height: 1.8; }

  .cover {
    width: 100%;
    max-height: 240px;
    object-fit: cover;
    border-radius: var(--glass-radius);
    border: 1px solid var(--border);
    margin-bottom: 26px;
  }

  .toc {
    padding: 18px 22px;
    margin-bottom: 28px;
    font-size: 13.5px;
  }
  .toc-t { margin-bottom: 12px; }
  .toc ol { margin: 0; padding-left: 20px; display: grid; gap: 7px; }
  .toc li.lvl3 { margin-left: 14px; }
  .toc a {
    color: var(--text);
    text-decoration: none;
    transition: color var(--t) var(--ease);
  }
  .toc a:hover { color: var(--primary-dark); }

  .tags {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 44px;
    padding-top: 22px;
    border-top: 1px solid var(--divider);
  }
  .lab { font-size: 12.5px; color: var(--text-muted); letter-spacing: .06em; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 11px;
    border-radius: 7px;
    font-size: 12px;
    text-decoration: none;
    color: var(--primary-dark);
    background: color-mix(in srgb, var(--primary) 11%, transparent);
    border: 1px solid color-mix(in srgb, var(--primary) 26%, transparent);
    transition: background var(--t) var(--ease), border-color var(--t) var(--ease);
  }
  .chip:hover {
    background: color-mix(in srgb, var(--primary) 22%, transparent);
    border-color: color-mix(in srgb, var(--primary) 48%, transparent);
  }

  .adj {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 28px;
  }
  .adj a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    text-decoration: none;
  }
  .adj .right { text-align: right; }
  .adj .dir { font-size: 12px; color: var(--text-muted); }
  .adj .ttl {
    font-size: 14px;
    color: var(--text-deep);
    line-height: 1.5;
  }
  .adj a:hover .ttl { color: var(--primary-dark); }

  .back { text-align: center; margin-top: 44px; }
  .back a {
    font-size: 13.5px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--t) var(--ease);
  }
  .back a:hover { color: var(--primary-dark); }

  @media (max-width: 640px) {
    .adj { grid-template-columns: 1fr; }
    .adj .right { text-align: left; }
  }
</style>
