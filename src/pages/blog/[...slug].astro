---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import {
  getPosts,
  formatDate,
  readingTime,
  categoryHref,
  tagHref,
  postHref,
  type Post,
} from '../../utils/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: i > 0 ? posts[i - 1] : null,
      older: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }));
}

interface Props {
  post: Post;
  newer: Post | null;
  older: Post | null;
}

const { post, newer, older } = Astro.props;
const { data, body } = post as Post & { body?: string };
const { Content, headings } = await render(post);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={`${data.title} · ze`} description={data.description ?? data.title}>
  <SiteHeader />

  <main class="shell">
    <article>
      <header class="post-head">
        <div class="meta">
          <a class="cat" href={categoryHref(data.category)}>{data.category}</a>
          <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
          <span class="sep" aria-hidden="true">·</span>
          <span>{readingTime(body)} 分钟</span>
          {data.updatedDate && (
            <>
              <span class="sep" aria-hidden="true">·</span>
              <span>更新于 {formatDate(data.updatedDate)}</span>
            </>
          )}
        </div>

        <h1>{data.title}</h1>

        {data.description && <p class="lead">{data.description}</p>}
      </header>

      {toc.length >= 3 && (
        <nav class="toc glass" aria-label="目录">
          <div class="toc-title">目录</div>
          <ol>
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'lvl3' : ''}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose">
        <Content />
      </div>

      {data.tags.length > 0 && (
        <footer class="post-foot">
          <span class="label">标签</span>
          {data.tags.map((t) => <a class="chip" href={tagHref(t)}>{t}</a>)}
        </footer>
      )}

      {(newer || older) && (
        <nav class="adjacent">
          {older ? (
            <a class="adj glass" href={postHref(older)}>
              <span class="dir">上一篇</span>
              <span class="ttl">{older.data.title}</span>
            </a>
          ) : <span />}
          {newer ? (
            <a class="adj glass right" href={postHref(newer)}>
              <span class="dir">下一篇</span>
              <span class="ttl">{newer.data.title}</span>
            </a>
          ) : <span />}
        </nav>
      )}
    </article>

    <p class="back"><a href="/blog/">← 返回博客列表</a></p>
  </main>
</BaseLayout>

<style>
  article {
    padding: 30px 0 40px;
    max-width: 760px;
    margin: 0 auto;
  }

  .post-head {
    padding-bottom: 26px;
    border-bottom: 1px solid var(--glass-border);
    margin-bottom: 30px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 12.5px;
    font-family: var(--font-mono);
    color: var(--text-3);
    margin-bottom: 16px;
  }

  .meta .cat {
    padding: 3px 10px;
    border-radius: 7px;
    font-family: var(--font-sans);
    font-weight: 600;
    text-decoration: none;
    color: #FFC9DC;
    background: rgba(255, 46, 120, .13);
    border: 1px solid rgba(255, 46, 120, .3);
    transition: background .18s, color .18s;
  }

  .meta .cat:hover { background: rgba(255, 46, 120, .26); color: #fff; }

  .sep { opacity: .5; }

  h1 {
    margin: 0 0 14px;
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 800;
    letter-spacing: -.03em;
    line-height: 1.22;
  }

  .lead {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--text-2);
  }

  .toc {
    padding: 20px 24px;
    margin-bottom: 30px;
    font-size: 13.5px;
  }

  .toc-title {
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: .08em;
    color: var(--violet);
    margin-bottom: 12px;
  }

  .toc ol {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 7px;
  }

  .toc li.lvl3 { margin-left: 14px; }

  .toc a {
    color: var(--text-2);
    text-decoration: none;
    transition: color .18s;
  }

  .toc a:hover { color: var(--violet); }

  .post-foot {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 44px;
    padding-top: 22px;
    border-top: 1px solid var(--glass-border);
  }

  .label {
    font-size: 12.5px;
    color: var(--text-3);
    letter-spacing: .06em;
  }

  .chip {
    padding: 4px 11px;
    border-radius: 7px;
    font-size: 12px;
    text-decoration: none;
    color: #D9C4FF;
    background: rgba(176, 125, 255, .12);
    border: 1px solid rgba(176, 125, 255, .24);
    transition: background .18s, color .18s, border-color .18s;
  }

  .chip:hover {
    background: rgba(176, 125, 255, .24);
    border-color: rgba(176, 125, 255, .5);
    color: #fff;
  }

  .adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 28px;
  }

  .adj {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    text-decoration: none;
    transition: background .2s, border-color .2s, transform .2s;
  }

  .adj.right { text-align: right; }

  .adj:hover {
    background: var(--glass-bg-hover);
    border-color: rgba(176, 125, 255, .42);
    transform: translateY(-2px);
  }

  .adj .dir {
    font-size: 12px;
    color: var(--text-3);
  }

  .adj .ttl {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-1);
    line-height: 1.5;
  }

  .back {
    text-align: center;
    padding-bottom: 60px;
    margin: 0;
  }

  .back a {
    font-size: 13.5px;
    color: var(--text-2);
    text-decoration: none;
    transition: color .18s;
  }

  .back a:hover { color: var(--violet); }

  @media (max-width: 640px) {
    .adjacent { grid-template-columns: 1fr; }
    .adj.right { text-align: left; }
  }
</style>
