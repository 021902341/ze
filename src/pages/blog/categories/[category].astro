---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ListPage from '../../../components/ListPage.astro';
import { getPosts, type Post } from '../../../utils/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const categories = [...new Set(posts.map((p) => p.data.category))];
  return categories.map((category) => ({
    params: { category },
    props: { category, posts: posts.filter((p) => p.data.category === category) },
  }));
}

interface Props {
  category: string;
  posts: Post[];
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`${category} · 分类 · ze`} description={`分类「${category}」下的全部文章`}>
  <ListPage
    title={category}
    sub={`${posts.length} 篇文章`}
    crumbs={[
      { href: '/blog/', label: '文章' },
      { href: '/blog/categories/', label: '分类' },
    ]}
    posts={posts}
  />
</BaseLayout>
