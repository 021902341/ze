---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPosts, formatDate, postHref, categoryHref } from '../../../utils/site';

const posts = await getPosts();

const byCategory = new Map<string, typeof posts>();
for (const p of posts) {
  const c = p.data.category;
  if (!byCategory.has(c)) byCategory.set(c, []);
  byCategory.get(c)!.push(p);
}

const groups = [...byCategory.entries()].sort(
  (a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], 'zh')
);
---

<BaseLayout title="分类 · ze" description="按分类浏览全部文章">
  <main class="wrap">
    <header class="head">
      <h1 class="page-title">分类</h1>
      <p class="page-sub">
        共 <b>{groups.length}</b> 个分类，<b>{posts.length}</b> 篇文章
      </p>
    </header>

    <div class="groups">
      {groups.map(([name, list]) => (
        <section class="group glass">
          <header class="gh">
            <h2>
              <span class="ic-folder" aria-hidden="true"></span>
              <a href={categoryHref(name)}>{name}</a>
            </h2>
            <span class="cnt">{list.length} 篇</span>
          </header>
          <ul>
            {list.map((p) => (
              <li>
                <a href={postHref(p)}>{p.data.title}</a>
                <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--content-w);
    margin: 0 auto;
    padding: 40px var(--shell-pad) 60px;
  }

  .head { text-align: center; padding-bottom: 30px; }
  .head .page-sub { margin-top: 12px; }
  .head b { color: var(--text-deep); font-family: var(--mono); }

  .groups { display: flex; flex-direction: column; gap: 14px; }

  .group { padding: 20px 24px; }

  .gh {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px dashed var(--divider);
  }
  .gh h2 {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 16px;
    font-weight: 400;
    color: var(--c-folder);
  }
  .gh h2 a {
    color: var(--text-deep);
    text-decoration: none;
    transition: color var(--t) var(--ease);
  }
  .gh h2 a:hover { color: var(--primary-dark); }
  .cnt { font-family: var(--mono); font-size: 12px; color: var(--text-muted); }

  ul { list-style: none; display: grid; gap: 9px; }
  li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
  }
  li a {
    font-size: 14px;
    color: var(--text);
    text-decoration: none;
    transition: color var(--t) var(--ease);
  }
  li a:hover { color: var(--primary-dark); }
  li time {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--c-date);
  }
</style>
