---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { getPosts, formatDate, postHref, categoryHref } from '../../../utils/site';

const posts = await getPosts();

const byCategory = new Map<string, typeof posts>();
for (const p of posts) {
  const c = p.data.category;
  if (!byCategory.has(c)) byCategory.set(c, []);
  byCategory.get(c)!.push(p);
}

const groups = [...byCategory.entries()].sort(
  (a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], 'zh')
);
---

<BaseLayout title="分类 · ze" description="按分类浏览全部文章">
  <SiteHeader />

  <main class="shell">
    <section class="page-head">
      <h1 class="grad-text">分类</h1>
      <p class="sub">共 <b>{groups.length}</b> 个分类，<b>{posts.length}</b> 篇文章</p>
    </section>

    <section class="groups">
      {groups.map(([name, list]) => (
        <article class="group glass">
          <header>
            <h2><a href={categoryHref(name)}>{name}</a></h2>
            <span class="count">{list.length} 篇</span>
          </header>
          <ul>
            {list.map((p) => (
              <li>
                <a href={postHref(p)}>{p.data.title}</a>
                <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    {groups.length === 0 && <p class="empty">还没有文章。</p>}
  </main>
</BaseLayout>

<style>
  .page-head { padding: 34px 0 26px; }

  h1 {
    margin: 0 0 12px;
    font-size: clamp(38px, 7vw, 62px);
    font-weight: 800;
    letter-spacing: -.035em;
    line-height: 1.05;
  }

  .sub { margin: 0; color: var(--text-2); font-size: 14px; }
  .sub b { color: var(--text-1); font-family: var(--font-mono); }

  .groups {
    display: grid;
    gap: 16px;
    padding-bottom: 60px;
  }

  .group { padding: 22px 24px; }

  .group header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--glass-border);
  }

  .group h2 { margin: 0; font-size: 18px; font-weight: 700; }

  .group h2 a { text-decoration: none; color: var(--text-1); transition: color .18s; }
  .group h2 a:hover { color: var(--violet); }

  .count {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--violet);
    opacity: .8;
  }

  .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }

  .group li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
  }

  .group li a {
    font-size: 14px;
    color: var(--text-2);
    text-decoration: none;
    transition: color .18s;
  }

  .group li a:hover { color: var(--violet); }

  .group li time {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
  }

  .empty { padding: 60px 0; text-align: center; color: var(--text-3); }
</style>
