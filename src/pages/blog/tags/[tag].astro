---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ListPage from '../../../components/ListPage.astro';
import { getPosts, type Post } from '../../../utils/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag} · 标签 · ze`} description={`标签「${tag}」下的全部文章`}>
  <ListPage
    title={`#${tag}`}
    sub={`${posts.length} 篇文章`}
    crumbs={[
      { href: '/blog/', label: '文章' },
      { href: '/blog/tags/', label: '标签' },
    ]}
    posts={posts}
  />
</BaseLayout>
