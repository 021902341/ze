---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPosts, type Post } from '../../../utils/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag} · 标签 · ze`} description={`标签「${tag}」下的全部文章`}>
  <SiteHeader />

  <main class="shell">
    <nav class="crumb">
      <a href="/blog/">博客</a>
      <span aria-hidden="true">/</span>
      <a href="/blog/tags/">标签</a>
    </nav>

    <section class="page-head">
      <h1 class="grad-text">#{tag}</h1>
      <p class="sub"><b>{posts.length}</b> 篇文章</p>
    </section>

    <section class="list">
      {posts.map((post) => <PostCard post={post} />)}
    </section>
  </main>
</BaseLayout>

<style>
  .crumb {
    display: flex;
    gap: 8px;
    padding: 26px 0 0;
    font-size: 12.5px;
    color: var(--text-3);
  }

  .crumb a { color: var(--text-3); text-decoration: none; transition: color .18s; }
  .crumb a:hover { color: var(--violet); }

  .page-head { padding: 18px 0 26px; }

  h1 {
    margin: 0 0 12px;
    font-size: clamp(32px, 6vw, 52px);
    font-weight: 800;
    letter-spacing: -.035em;
    line-height: 1.1;
  }

  .sub { margin: 0; color: var(--text-2); font-size: 14px; }
  .sub b { color: var(--text-1); font-family: var(--font-mono); }

  .list { display: grid; gap: 16px; padding-bottom: 60px; }
</style>
