---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { getPosts, countBy, tagHref } from '../../../utils/site';

const posts = await getPosts();
const tags = countBy(posts.flatMap((p) => p.data.tags));
const max = Math.max(1, ...tags.map(([, n]) => n));
const total = posts.reduce((s, p) => s + p.data.tags.length, 0);
---

<BaseLayout title="标签 · ze" description="按标签浏览全部文章">
  <SiteHeader />

  <main class="shell">
    <section class="page-head">
      <h1 class="grad-text">标签</h1>
      <p class="sub">
        共 <b>{tags.length}</b> 个标签，累计引用 <b>{total}</b> 次 —— 字号越大出现得越多
      </p>
    </section>

    <section class="cloud glass">
      {tags.map(([name, n]) => (
        <a
          class="tag"
          href={tagHref(name)}
          style={`--w:${(n / max).toFixed(2)}`}
        >
          {name}<span class="n">{n}</span>
        </a>
      ))}
    </section>

    {tags.length === 0 && <p class="empty">还没有标签。</p>}
  </main>
</BaseLayout>

<style>
  .page-head { padding: 34px 0 26px; }

  h1 {
    margin: 0 0 12px;
    font-size: clamp(38px, 7vw, 62px);
    font-weight: 800;
    letter-spacing: -.035em;
    line-height: 1.05;
  }

  .sub { margin: 0; color: var(--text-2); font-size: 14px; }
  .sub b { color: var(--text-1); font-family: var(--font-mono); }

  .cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 30px 28px;
    margin-bottom: 60px;
  }

  .tag {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 7px 15px;
    border-radius: 11px;
    text-decoration: none;
    color: #D9C4FF;
    background: rgba(176, 125, 255, .12);
    border: 1px solid rgba(176, 125, 255, .24);
    font-weight: 600;
    font-size: calc(12.5px + var(--w) * 7px);
    transition: background .18s, color .18s, border-color .18s, transform .18s;
  }

  .tag:hover {
    background: rgba(176, 125, 255, .26);
    border-color: rgba(176, 125, 255, .55);
    color: #fff;
    transform: translateY(-2px);
  }

  .tag .n {
    font-family: var(--font-mono);
    font-size: 11px;
    opacity: .6;
  }

  .empty { padding: 60px 0; text-align: center; color: var(--text-3); }
</style>
