---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPosts, countBy, tagHref } from '../../../utils/site';

const posts = await getPosts();
const tags = countBy(posts.flatMap((p) => p.data.tags));
const max = Math.max(1, ...tags.map(([, n]) => n));
const total = posts.reduce((s, p) => s + p.data.tags.length, 0);
---

<BaseLayout title="标签 · ze" description="按标签浏览全部文章">
  <main class="wrap">
    <header class="head">
      <h1 class="page-title">标签</h1>
      <p class="page-sub">
        共 <b>{tags.length}</b> 个标签，累计引用 <b>{total}</b> 次 —— 字号越大出现得越多
      </p>
    </header>

    <section class="cloud glass">
      {tags.map(([name, n]) => (
        <a href={tagHref(name)} style={`font-size:${(12.5 + (n / max) * 7).toFixed(1)}px`}>
          <span class="ic-tag" aria-hidden="true"></span>{name}<em>{n}</em>
        </a>
      ))}
    </section>

    {tags.length === 0 && <div class="empty glass">还没有标签。</div>}
  </main>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--content-w);
    margin: 0 auto;
    padding: 40px var(--shell-pad) 60px;
  }

  .head { text-align: center; padding-bottom: 30px; }
  .head .page-sub { margin-top: 12px; }
  .head b { color: var(--text-deep); font-family: var(--mono); }

  .cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 16px;
    padding: 30px 28px;
  }

  .cloud a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--primary-dark);
    text-decoration: none;
    transition: color var(--t) var(--ease), transform var(--t) var(--ease);
  }
  .cloud a:hover {
    color: var(--primary);
    transform: translateY(-2px);
  }
  .cloud a em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-muted);
  }

  .empty {
    padding: 50px 30px;
    text-align: center;
    color: var(--text-muted);
    font-size: 14px;
  }
</style>
