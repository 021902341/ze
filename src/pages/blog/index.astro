---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, countBy, categoryHref } from '../../utils/site';

const posts = await getPosts();
const categories = countBy(posts.map((p) => p.data.category));
const allTags = countBy(posts.flatMap((p) => p.data.tags));
---

<BaseLayout title="文章 · ze" description="全部文章 —— 学习、踩坑与建站记录">
  <main class="wrap">
    <header class="head">
      <h1 class="page-title">文章</h1>
      <p class="page-sub">
        共 <b>{posts.length}</b> 篇 · <b>{categories.length}</b> 个分类 ·
        <b>{allTags.length}</b> 个标签
      </p>
    </header>

    <nav class="filters" aria-label="分类筛选">
      <a class="pill on" href="/blog/">全部 <span>{posts.length}</span></a>
      {categories.map(([name, n]) => (
        <a class="pill" href={categoryHref(name)}>{name} <span>{n}</span></a>
      ))}
    </nav>

    <div class="list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    {posts.length === 0 && (
      <div class="empty glass">
        还没有文章。往 <code>src/content/blog/</code> 里放 Markdown 就会出现在这里。
      </div>
    )}
  </main>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--content-w);
    margin: 0 auto;
    padding: 40px var(--shell-pad) 60px;
  }

  .head { text-align: center; padding-bottom: 30px; }
  .head .page-sub { margin-top: 12px; }
  .head b { color: var(--text-deep); font-family: var(--mono); }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-bottom: 28px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    border-radius: 9px;
    font-size: 13px;
    text-decoration: none;
    color: var(--text);
    background: color-mix(in srgb, var(--primary) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
    transition: background var(--t) var(--ease), border-color var(--t) var(--ease), color var(--t) var(--ease);
  }
  .pill:hover {
    background: color-mix(in srgb, var(--primary) 18%, transparent);
    border-color: color-mix(in srgb, var(--primary) 40%, transparent);
  }
  .pill.on {
    color: #fff;
    background: var(--primary);
    border-color: var(--primary);
  }
  .pill span { font-family: var(--mono); font-size: 11px; opacity: .75; }

  .list { display: flex; flex-direction: column; gap: 14px; }

  .empty {
    padding: 50px 30px;
    text-align: center;
    color: var(--text-muted);
    font-size: 14px;
  }
  .empty code {
    font-family: var(--mono);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    padding: 2px 7px;
    border-radius: 5px;
    color: var(--primary-dark);
  }
</style>
