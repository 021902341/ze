---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIALS } from '../data/site';

const facts = [
  ['坐标', '天津'],
  ['状态', '软件工程 · 专升本在读'],
  ['方向', '前端 / 全栈 · 备考 2027 专升本'],
  ['在写', 'C 语言专项练习、建站笔记'],
  ['工具', 'Obsidian（第二大脑）· VS Code · GitHub Desktop'],
];

const stack = ['HTML / CSS / JavaScript', 'Astro', 'Vue', 'TypeScript', 'C', 'Node.js', 'Cloudflare Workers'];

const siteFacts = [
  ['框架', 'Astro 7'],
  ['样式', '原生 CSS + design token'],
  ['内容', 'Markdown + Content Collections'],
  ['字体', '霞鹜文楷屏幕版（分片按需加载）'],
  ['写作', 'Obsidian'],
  ['部署', '纯静态 · 海内外双站'],
];
---

<BaseLayout title="关于 · ze" description="关于我 —— 软件工程专升本，天津">
  <main class="wrap">
    <header class="head">
      <h1 class="page-title">关于</h1>
      <p class="page-sub">自我介绍，以及这个站的技术说明。</p>
    </header>

    <div class="cards">
      <article class="glass card">
        <h2 class="rhombus-h">我是谁</h2>
        <p>
          专科应届，正在准备专升本的软件工程方向。平时把学到的东西往这个站里丢，
          算是给自己的一个交代 —— 学没学会，写出来才知道。
        </p>
        <ul class="facts">
          {facts.map(([k, v]) => (
            <li><span class="k">{k}</span><span class="v">{v}</span></li>
          ))}
        </ul>
      </article>

      <article class="glass card">
        <h2 class="rhombus-h">技术栈</h2>
        <p>在学和在用的，谈不上精通，够用就行。</p>
        <div class="stack">
          {stack.map((s) => <span class="tech">{s}</span>)}
        </div>
      </article>

      <article class="glass card">
        <h2 class="rhombus-h">这个站</h2>
        <p>
          纯静态站点，没有任何服务器。内容用 Markdown 写，构建成静态 HTML，
          同一份代码部署到海外和国内两个平台。
        </p>
        <ul class="facts">
          {siteFacts.map(([k, v]) => (
            <li><span class="k">{k}</span><span class="v">{v}</span></li>
          ))}
        </ul>
      </article>

      <article class="glass card">
        <h2 class="rhombus-h">找到我</h2>
        <p>主要活动在两个地方：</p>
        <ul class="links">
          {SOCIALS.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener">
                <span class="k">{s.label}</span><span class="v">{s.short} →</span>
              </a>
            </li>
          ))}
          <li>
            <a href="/reference-ranking.html">
              <span class="k">建站选型榜单</span><span class="v">82 个项目 →</span>
            </a>
          </li>
        </ul>
      </article>
    </div>
  </main>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--content-w);
    margin: 0 auto;
    padding: 40px var(--shell-pad) 60px;
  }

  .head { text-align: center; padding-bottom: 34px; }
  .head .page-sub { margin-top: 12px; }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 16px;
  }

  .card { padding: 22px 24px; }
  .card p {
    margin: 0 0 16px;
    font-size: 13.5px;
    line-height: 1.8;
    color: var(--text);
  }

  .facts, .links { list-style: none; display: grid; gap: 9px; }
  .facts li, .links li a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 8px;
    border-bottom: 1px dashed var(--divider);
  }
  .facts li:last-child, .links li:last-child a { border-bottom: none; padding-bottom: 0; }

  .links li a { text-decoration: none; transition: color var(--t) var(--ease); }
  .links li a:hover .v { color: var(--primary-dark); }

  .k { flex: 0 0 auto; font-size: 12.5px; color: var(--text-muted); }
  .v { font-size: 13px; color: var(--text); text-align: right; transition: color var(--t) var(--ease); }

  .stack { display: flex; flex-wrap: wrap; gap: 7px; }
  .tech {
    padding: 5px 11px;
    border-radius: 8px;
    font-size: 12px;
    font-family: var(--mono);
    color: var(--primary-dark);
    background: color-mix(in srgb, var(--primary) 11%, transparent);
    border: 1px solid color-mix(in srgb, var(--primary) 26%, transparent);
  }
</style>
