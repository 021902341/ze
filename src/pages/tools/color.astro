---
import ToolShell from '../../layouts/ToolShell.astro';

/** 品牌色板：与 src/styles/global.css 的 token 保持一致 */
const PALETTE = [
  { name: 'primary', hex: '#DF9193' },
  { name: 'primary-light', hex: '#e5a5a6' },
  { name: 'primary-lighter', hex: '#eab9ba' },
  { name: 'primary-dark', hex: '#d67174' },
  { name: 'complement', hex: '#d6a29a' },
  { name: 'adjacent', hex: '#dfb391' },
  { name: 'pin', hex: '#e8b288' },
  { name: 'pin-border', hex: '#f4e6da' },
  { name: 'folder', hex: '#f5c518' },
  { name: 'date', hex: '#3d6b7a' },
] as const;
---

<ToolShell title="颜色转换" desc="HEX / RGB / HSL 互转，下方是本站品牌色板，点哪块复制哪块。">
  <div class="row" style="margin-bottom:16px">
    <input id="picker" type="color" value="#DF9193" aria-label="选择颜色" />
    <input id="hex-in" type="text" value="#DF9193" spellcheck="false" style="flex:1;min-width:160px" aria-label="HEX 颜色值" />
  </div>

  <div class="outs">
    <div class="kv"><b>HEX</b><span id="o-hex" class="cp" title="点击复制">—</span></div>
    <div class="kv"><b>RGB</b><span id="o-rgb" class="cp" title="点击复制">—</span></div>
    <div class="kv"><b>HSL</b><span id="o-hsl" class="cp" title="点击复制">—</span></div>
  </div>

  <div class="divider"></div>

  <div class="fld">
    <label>品牌色板（点击复制 HEX）</label>
    <div class="palette">
      {PALETTE.map((c) => (
        <button class="sw" type="button" data-hex={c.hex} title={`${c.name} ${c.hex}`}
                style={`--sc:${c.hex}`}>
          <span class="chip" aria-hidden="true"></span>
          <span class="lb">{c.name}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="copied" id="copied" aria-live="polite"></div>
</ToolShell>

<style>
  #picker {
    width: 46px; height: 38px; padding: 2px;
    border: 1px solid var(--border); border-radius: 9px;
    background: var(--bg-soft); cursor: pointer;
  }
  .outs { display: flex; flex-direction: column; gap: 9px; }
  .cp { cursor: pointer; }
  .cp:hover { color: var(--primary-dark); }

  .palette { display: flex; flex-wrap: wrap; gap: 9px; }
  .sw {
    display: flex; align-items: center; gap: 7px;
    padding: 6px 11px 6px 7px;
    border: 1px solid var(--border); border-radius: 9px;
    background: var(--bg-soft); cursor: pointer;
    font: inherit; font-size: 12px; color: var(--text);
    transition: border-color var(--t) var(--ease), transform var(--t) var(--ease);
  }
  .sw:hover { border-color: var(--sc); transform: translateY(-1px); }
  .sw .chip {
    width: 18px; height: 18px; border-radius: 6px;
    background: var(--sc);
    border: 1px solid color-mix(in srgb, #000 12%, transparent);
  }

  .copied {
    position: fixed; left: 50%; bottom: 34px; transform: translateX(-50%) translateY(10px);
    background: var(--text-deep); color: var(--bg);
    font-size: 12.5px; padding: 7px 16px; border-radius: 9px;
    opacity: 0; pointer-events: none;
    transition: opacity .25s var(--ease), transform .25s var(--ease);
    z-index: 300;
  }
  .copied.show { opacity: 1; transform: translateX(-50%) translateY(0); }
</style>

<script>
  const picker = document.getElementById('picker') as HTMLInputElement;
  const hexIn = document.getElementById('hex-in') as HTMLInputElement;
  const oHex = document.getElementById('o-hex')!;
  const oRgb = document.getElementById('o-rgb')!;
  const oHsl = document.getElementById('o-hsl')!;
  const copied = document.getElementById('copied')!;
  let toastT = 0;

  const toast = (text: string) => {
    copied.textContent = `已复制 ${text}`;
    copied.classList.add('show');
    clearTimeout(toastT);
    toastT = setTimeout(() => copied.classList.remove('show'), 1600);
  };
  const copy = async (text: string) => {
    try { await navigator.clipboard.writeText(text); toast(text); }
    catch { /* 剪贴板不可用就静默 */ }
  };

  const norm = (v: string): string | null => {
    let h = v.trim().replace(/^#/, '');
    if (/^[0-9a-fA-F]{3}$/.test(h)) h = h.split('').map((c) => c + c).join('');
    return /^[0-9a-fA-F]{6}$/.test(h) ? '#' + h.toLowerCase() : null;
  };

  const render = (hex: string) => {
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    const rn = r / 255, gn = g / 255, bn = b / 255;
    const max = Math.max(rn, gn, bn), min = Math.min(rn, gn, bn);
    const l = (max + min) / 2;
    let h = 0, s = 0;
    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      if (max === rn) h = ((gn - bn) / d + (gn < bn ? 6 : 0)) / 6;
      else if (max === gn) h = ((bn - rn) / d + 2) / 6;
      else h = ((rn - gn) / d + 4) / 6;
    }
    oHex.textContent = hex;
    oRgb.textContent = `rgb(${r}, ${g}, ${b})`;
    oHsl.textContent = `hsl(${Math.round(h * 360)}, ${Math.round(s * 100)}%, ${Math.round(l * 100)}%)`;
  };

  picker.addEventListener('input', () => { hexIn.value = picker.value; render(picker.value); });
  hexIn.addEventListener('input', () => {
    const h = norm(hexIn.value);
    if (h) { picker.value = h; render(h); }
  });
  for (const el of [oHex, oRgb, oHsl]) {
    el.addEventListener('click', () => el.textContent && copy(el.textContent));
  }
  document.querySelectorAll<HTMLButtonElement>('.sw').forEach((b) =>
    b.addEventListener('click', () => copy(b.dataset.hex!))
  );

  render('#df9193');
</script>
