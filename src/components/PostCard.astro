---
import type { Post } from '../utils/site';
import { formatDate, postHref, categoryHref, tagHref } from '../utils/site';

interface Props {
  post: Post;
  /** 首页精选/轮播位把方向反过来用 */
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const { data } = post;
const href = postHref(post);
---

<article class={`pc glass glass-hover${compact ? ' compact' : ''}`}>
  <div class="ct">
    <div class="dt">
      <span class="ic-clock" aria-hidden="true"></span>
      编辑于 <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
    </div>

    <h3><a href={href}>{data.title}</a></h3>

    <div class="tax">
      <a class="folder" href={categoryHref(data.category)}>
        <span class="ic-folder" aria-hidden="true"></span>{data.category}
      </a>
      {data.tags.length > 0 && (
        <span class="tag">
          <span class="ic-tag" aria-hidden="true"></span>
          {data.tags.map((t, i) => (
            <>
              {i > 0 && <span class="dot">·</span>}
              <a href={tagHref(t)}>{t}</a>
            </>
          ))}
        </span>
      )}
    </div>

    {data.description && <p class="ex">{data.description}</p>}
  </div>

  {data.cover ? (
    <img class="cover" src={data.cover} alt="" loading="lazy" />
  ) : (
    !compact && <div class="ph">封面图</div>
  )}
</article>

<style>
  .pc {
    display: grid;
    grid-template-columns: 1fr 46%;
    min-height: 172px;
    overflow: hidden;
    text-decoration: none;
  }

  .pc.compact { grid-template-columns: 1fr; min-height: 0; }

  .ct {
    padding: 20px 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .dt {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--c-date);
    margin-bottom: 10px;
    font-family: var(--mono);
  }

  h3 {
    font-size: 19px;
    font-weight: 400;
    line-height: 1.5;
    margin-bottom: 10px;
  }
  h3 a {
    color: var(--text-deep);
    text-decoration: none;
    transition: color var(--t) var(--ease);
  }
  .pc:hover h3 a { color: var(--primary-dark); }

  .tax {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 12.5px;
    margin-bottom: 9px;
  }

  .folder {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--c-folder);
    text-decoration: none;
  }
  .folder:hover { text-decoration: underline; text-underline-offset: 3px; }

  .tag {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--c-tag);
    clip-path: none;
  }
  .tag a {
    color: var(--c-tag);
    text-decoration: none;
  }
  .tag a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .dot { color: var(--text-muted); }

  .ex {
    font-size: 12.5px;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-left: 1px solid var(--border);
  }

  .ph {
    border-left: 1px solid var(--border);
  }

  @media (max-width: 720px) {
    .pc { grid-template-columns: 1fr; }
    .cover, .ph { display: none; }
  }
</style>
