---
/**
 * 全站搜索弹层 —— Pagefind 静态全文搜索。
 * 触发：导航栏搜索按钮 / Cmd(Ctrl)+K；Esc 或点遮罩关闭。
 * 索引进程：postbuild 跑 `pagefind --site dist`，产物在 /pagefind/。
 * 开发模式（无索引）会显示友好提示，不影响其他功能。
 */
---

<div class="search-layer" id="search-layer" hidden>
  <div class="backdrop" data-close></div>
  <div class="panel glass" role="dialog" aria-modal="true" aria-label="全站搜索">
    <div class="bar">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
      </svg>
      <input id="search-input" type="search" placeholder="搜索文章标题、正文…"
             autocomplete="off" spellcheck="false" aria-label="搜索" />
      <kbd>Esc</kbd>
    </div>
    <div class="results" id="search-results" role="listbox" aria-label="搜索结果"></div>
    <div class="foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>Enter</kbd> 打开</span>
      <span class="r">Pagefind 静态索引</span>
    </div>
  </div>
</div>

<style is:global>
  .search-layer { position: fixed; inset: 0; z-index: 200; }
  .search-layer[hidden] { display: none; }
  .search-layer .backdrop {
    position: absolute; inset: 0;
    background: color-mix(in srgb, var(--text-deep) 32%, transparent);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  .search-layer .panel {
    position: relative;
    max-width: 580px;
    margin: 11vh auto 0;
    overflow: hidden;
    border-radius: 16px;
  }
  .search-layer .bar {
    display: flex; align-items: center; gap: 10px;
    padding: 13px 16px;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
  }
  .search-layer .bar input {
    flex: 1; border: none; outline: none; background: transparent;
    font: inherit; font-size: 14.5px; color: var(--text-deep);
  }
  .search-layer .bar input::placeholder { color: var(--text-muted); }
  .search-layer kbd {
    font-family: var(--mono); font-size: 10.5px;
    padding: 1px 6px; border-radius: 5px;
    border: 1px solid var(--border);
    background: var(--bg-soft); color: var(--text-muted);
  }
  .search-layer .results {
    max-height: min(46vh, 420px); overflow-y: auto;
    padding: 6px;
  }
  .search-layer .results:empty { display: none; }
  .search-layer .item {
    display: block; padding: 10px 12px; border-radius: 10px;
    text-decoration: none; color: var(--text);
  }
  .search-layer .item.active {
    background: color-mix(in srgb, var(--primary) 12%, transparent);
  }
  .search-layer .item .t {
    font-size: 14px; color: var(--text-deep);
    margin-bottom: 3px;
  }
  .search-layer .item .e {
    font-size: 12px; color: var(--text-muted);
    line-height: 1.65;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-layer .item mark {
    background: color-mix(in srgb, var(--primary) 32%, transparent);
    color: var(--text-deep); border-radius: 3px; padding: 0 1px;
  }
  .search-layer .msg {
    padding: 22px 16px; text-align: center;
    font-size: 13px; color: var(--text-muted);
  }
  .search-layer .foot {
    display: flex; gap: 14px; align-items: center;
    padding: 9px 16px; font-size: 11px; color: var(--text-muted);
    border-top: 1px solid var(--border);
  }
  .search-layer .foot .r { margin-left: auto; }
  @media (max-width: 640px) {
    .search-layer .panel { margin: 8vh 14px 0; }
  }
</style>

<script>
  const layer = document.getElementById('search-layer')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const box = document.getElementById('search-results')!;
  let pf: any = null;
  let pfFailed = false;
  let items: { url: string; el: HTMLAnchorElement }[] = [];
  let active = -1;

  async function ensurePagefind() {
    if (pf || pfFailed) return;
    try {
      pf = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
      await pf.init();
    } catch {
      pfFailed = true; // 开发模式无索引
    }
  }

  function open() {
    layer.hidden = false;
    document.body.style.overflow = 'hidden';
    input.value = '';
    render([]);
    setTimeout(() => input.focus(), 30);
    ensurePagefind().then(() => {
      if (pfFailed) {
        box.innerHTML = '<div class="msg">开发模式下没有搜索索引。<br>执行 <code>npm run build</code> 后会自动生成。</div>';
      }
    });
  }

  function close() {
    layer.hidden = true;
    document.body.style.overflow = '';
    (document.getElementById('search-open') as HTMLElement | null)?.focus?.();
  }

  function setActive(i: number) {
    active = i;
    items.forEach(({ el }, j) => el.classList.toggle('active', j === i));
    if (i >= 0) items[i].el.scrollIntoView({ block: 'nearest' });
  }

  function render(rows: { url: string; title: string; excerpt: string }[], msg?: string) {
    items = []; active = -1;
    if (msg) { box.innerHTML = `<div class="msg">${msg}</div>`; return; }
    if (!rows.length) { box.innerHTML = ''; return; }
    box.innerHTML = '';
    for (const r of rows) {
      const a = document.createElement('a');
      a.className = 'item';
      a.href = r.url;
      a.setAttribute('role', 'option');
      a.innerHTML = `<div class="t">${r.title}</div><div class="e">${r.excerpt}</div>`;
      box.appendChild(a);
      items.push({ url: r.url, el: a });
    }
  }

  let seq = 0;
  input.addEventListener('input', async () => {
    const q = input.value.trim();
    if (!q) { render([]); return; }
    if (pfFailed || !pf) { return; }
    const my = ++seq;
    const res = await pf.debouncedSearch(q, {}, 200);
    if (my !== seq) return;          // 已有更新的搜索
    if (!res) return;                // 被去抖取消
    if (!res.results.length) { render([], `没有找到「${q}」相关的内容`); return; }
    const rows = await Promise.all(
      res.results.slice(0, 8).map(async (r: any) => {
        const d = await r.data();
        return {
          url: d.url,
          title: d.meta?.title ?? d.url,
          excerpt: d.excerpt ?? '',
        };
      })
    );
    if (my === seq) render(rows);
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(Math.min(items.length - 1, active + 1)); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(Math.max(0, active - 1)); }
    else if (e.key === 'Enter' && active >= 0) { location.href = items[active].url; }
  });

  document.getElementById('search-open')?.addEventListener('click', open);
  layer.querySelector('[data-close]')?.addEventListener('click', close);

  addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      layer.hidden ? open() : close();
    } else if (e.key === 'Escape' && !layer.hidden) {
      close();
    }
  });
</script>
